# Copy this file to .env and fill in values locally.
# Never commit real keys.

# Endpoint used by family generation, evaluation, and most LLM calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional separate routing for the diagnostic judge / free-form evaluator.
# If unset, runners fall back to OPENAI_API_KEY / OPENAI_BASE_URL.
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_BASE_URL=

# Optional separate routing for write-time defenses.
# If unset, python -m memform run-defense falls back to the agent endpoint.
DEFENSE_OPENAI_API_KEY=
DEFENSE_OPENAI_BASE_URL=

# Optional model overrides for free-form adjudication.
# FREEFORM_PARSER_MODEL=gpt-5.4-nano
# FREEFORM_JUDGE_MODEL=gpt-5.6-sol
